<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- que no se puedan crear productos desde las ordenes de venta -->
    <record id="view_order_form_restrict_product_creation" model="ir.ui.view">
        <field name="name">sale.order.form.restrict</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>

    <!-- que no se puedan crear productos desde las ordenes de compra -->
    <record id="purchase_order_form_restrict_product_creation" model="ir.ui.view">
        <field name="name">purchase.order.form.restrict</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>

    <!-- que no se puedan crear productos desde las facturas -->
    <record id="view_move_form_restrict_product_creation" model="ir.ui.view">
        <field name="name">account.move.form.restrict</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>

</odoo>