<odoo>
    <data>
        
        <!-- Ver la impresora por defecto del usuario -->
        <record id="view_users_form" model="ir.ui.view">
            <field name="name">res.users.form.inherit</field>
            <field name="model">res.users</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='access_rights']" position="after">
                    <page string="Devices">
                        <group>
                            <field name="printer_id"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        
        <menuitem id="menu_zebra" name="Zebra Printers" parent="base.menu_custom" sequence="60"/>

        <!-- Printers -->
        <record id="view_zebra_printer_form" model="ir.ui.view">
            <field name="model">zebra.printer</field>
            <field name="arch" type="xml">
                <form string="Zebra printers">
                    <sheet>
                        <group>
                            <group string="Printer">
                                <field name="name"/>
                                <field name="model"/>
                                <field name="active"/>
                            </group>    
                            <group string="Network">
                                <field name="ip"/>
                                <field name="port"/>
                                <field name="buffer_size"/>
                            </group>
                        </group>
                    </sheet> 
                </form>
            </field>
        </record>
        <record id="view_zebra_printer_tree" model="ir.ui.view">
            <field name="model">zebra.printer</field>
            <field name="arch" type="xml">
                <tree string="Zebra printers">
                    <field name="name"/>
                    <field name="ip"/>
                    <field name="port"/>
                </tree>
            </field>
        </record>
    
    
        <record id="action_zebra_printer" model="ir.actions.act_window">
            <field name="name">Printers</field>
            <field name="res_model">zebra.printer</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_zebra_printer_tree"/>
        </record>
        <menuitem action="action_zebra_printer" id="menu_action_zebra_printer" parent="menu_zebra" sequence="1"/>

      
    </data>
</odoo>