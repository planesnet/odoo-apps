<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_sanitizer" model="ir.ui.view">
        <field name="name">res.company.form.inherit.sanitizer</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="report_footer" invisible="1"/>
            </xpath>
            
            <xpath expr="//field[@name='report_footer']" position="attributes">
                <attribute name="options">{'style-inline': true}</attribute>
            </xpath>
        </field>
    </record>
</odoo>