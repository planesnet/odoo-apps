<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Variable hide proforma  -->
    <record id="field_res_company_x_hide_proforma" model="ir.model.fields">
        <field name="name">x_hide_proforma</field>
        <field name="field_description">Ocultar Proforma y Borrador</field>
        <field name="model_id" ref="base.model_res_company" />
        <field name="ttype">boolean</field>
        <field name="state">manual</field>
    </record>

    <record id="field_base_document_layout_x_hide_proforma" model="ir.model.fields">
        <field name="name">x_hide_proforma</field>
        <field name="field_description">Ocultar Proforma y Borrador</field>
        <field name="model_id" ref="web.model_base_document_layout" />
        <field name="ttype">boolean</field>
        <field name="related">company_id.x_hide_proforma</field>
        <field name="state">manual</field>
    </record>

    <!-- Variable mostrar giro bancario -->
    <record id="field_res_company_x_hide_bank_info" model="ir.model.fields">
        <field name="name">x_hide_bank_info</field>
        <field name="field_description">Ocultar Giro Bancario</field>
        <field name="model_id" ref="base.model_res_company" />
        <field name="ttype">boolean</field>
        <field name="state">manual</field>
    </record>

    <record id="field_base_document_layout_x_hide_bank_info" model="ir.model.fields">
        <field name="name">x_hide_bank_info</field>
        <field name="field_description">Ocultar Giro Bancario</field>
        <field name="model_id" ref="web.model_base_document_layout" />
        <field name="ttype">boolean</field>
        <field name="related">company_id.x_hide_bank_info</field>
        <field name="state">manual</field>
    </record>

    <!-- Add variable in document layout form -->
    <record id="view_document_layout_form_inherit_proforma" model="ir.ui.view">
        <field name="name">base.document.layout.form.inherit.proforma</field>
        <field name="model">base.document.layout</field>
        <field name="inherit_id" ref="web.view_base_document_layout" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='paperformat_id']" position="after">
                <field name="x_hide_proforma" string="Ocultar 'Proforma' en Facturas"
                    widget="boolean_toggle" />
                <field name="x_hide_bank_info" string="Ocultar Giro Bancario"
                    widget="boolean_toggle" />
            </xpath>
        </field>
    </record>

    <!-- Modify invoice report to use the variable -->
    <record id="report_invoice_document_inherit_proforma" model="ir.ui.view">
        <field name="name">account.report.invoice.document.inherit.proforma</field>
        <field name="inherit_id" ref="account.report_invoice_document" />
        <field name="priority" eval="1000" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('page')]" position="before">
                <t t-set="is_immediate"
                    t-value="o.invoice_payment_term_id and o.invoice_payment_term_id.get_external_id().get(o.invoice_payment_term_id.id) == 'account.account_payment_term_immediate'" />

                <t t-if="is_immediate and res_company.x_hide_bank_info">
                    <style>
                        #qrcode, .payment_communication, [name='payment_communication'],
                        div:has(> p:contains("direct debit")), div:has(>
                        p:contains("domiciliación
                        bancaria")) {
                        display: none !important;
                        }
                    </style>
                </t>
            </xpath>

            <!-- Gestión de la visibilidad de la proforma -->
            <xpath expr="//t[@t-if='not proforma']" position="attributes">
                <attribute name="t-if">not proforma or res_company.x_hide_proforma</attribute>
            </xpath>

            <xpath expr="//t[@t-else='']" position="attributes">
                <attribute name="t-if">proforma and not res_company.x_hide_proforma</attribute>
            </xpath>

            <!-- Gestión del giro bancario -->
            <xpath expr="//p[@name='payment_communication']" position="replace">
                <p name="payment_communication"
                    t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference and o.invoice_payment_term_id and not is_immediate and res_company.x_hide_bank_info">
                    Comunicación de pago: <span class="fw-bold" t-field="o.payment_reference">
                    INV/2023/00001</span>
                   <t t-set="company_banks"
                        t-value="res_company.partner_id.bank_ids" />
                    <t t-if="company_banks">
                        <br />
                        <span> en esta cuenta: </span>
                        <t t-foreach="company_banks" t-as="bank">
                            <span class="fw-bold" t-out="bank.acc_number" />
                            <t t-if="not bank_last">
                                <span> o </span>
                            </t>
                        </t>
                    </t>
                </p>
            </xpath>

            <!-- Gestión de la visibilidad del comentario -->
            <xpath expr="//div[@name='comment']" position="attributes">
                <attribute name="t-if">not is_immediate and not is_html_empty(o.narration) and
                    res_company.x_hide_bank_info</attribute>
            </xpath>

        </field>
    </record>
</odoo>