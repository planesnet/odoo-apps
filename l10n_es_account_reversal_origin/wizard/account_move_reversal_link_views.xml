<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_reversal_link_form" model="ir.ui.view">
        <field name="name">account.move.reversal.link.form</field>
        <field name="model">account.move.reversal.link</field>
        <field name="arch" type="xml">
            <form string="Vincular Factura de Origen">
                <sheet>
                    <group>
                        <group>
                            <field name="move_id" invisible="1"/>
                            <field name="move_type" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="partner_id" readonly="1" force_save="1"/>                            
                            <field name="origin_move_id"
                                   domain="[
                                       ('partner_id', '=', partner_id),
                                       ('move_type', '=', move_type == 'out_refund' and 'out_invoice' or 'in_invoice'),
                                       ('state', '=', 'posted'),
                                       ('company_id', '=', company_id)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="copy_lines" invisible="origin_move_id == False"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_link_reversal" string="Vincular y Procesar" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Descartar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>