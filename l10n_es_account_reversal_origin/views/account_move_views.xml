<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_reversal_link" model="ir.ui.view">
        <field name="name">account.move.form.inherit.reversal.link</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_reversal_link_wizard" 
                        string="Vincular Origen" 
                        type="object" 
                        class="oe_highlight"
                        invisible="move_type not in ('out_refund', 'in_refund') or state != 'draft' or reversed_entry_id != False"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>